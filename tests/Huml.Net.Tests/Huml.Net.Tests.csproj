<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Huml.Net\Huml.Net.csproj" />
    <!-- ReferenceOutputAssembly=true so the G3.2b harness can instantiate the generator type;
         OutputItemType=Analyzer so it still runs as a generator for the integration tests. -->
    <ProjectReference Include="..\..\src\Huml.Net.SourceGeneration\Huml.Net.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="AwesomeAssertions" Version="9.5.0" />
    <!-- Source-generator compilation-test harness (G3.2b). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\fixtures\v0.1\**\*"
             Link="fixtures\v0.1\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\fixtures\v0.2\**\*"
             Link="fixtures\v0.2\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\fixtures\extensions\**\*"
             Link="fixtures\extensions\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
